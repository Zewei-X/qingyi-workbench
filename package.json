{
  "name": "vc-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "python3 scripts/build-data.py",
    "contact-cc": "python3 scripts/import-contact-cc.py",
    "feishu-links": "python3 scripts/import-feishu-links.py",
    "investors": "python3 scripts/import-investor-orgs.py",
    "cf:login": "wrangler login",
    "cf:db": "wrangler d1 create vc-workbench",
    "cf:migrate:local": "wrangler d1 migrations apply vc-workbench --local",
    "cf:migrate": "wrangler d1 migrations apply vc-workbench --remote",
    "cf:dev": "npm run build && wrangler pages dev dist --d1=DB --persist-to=.wrangler/state",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name=vc-workbench"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.164.0"
  }
}
